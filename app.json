{
  "expo": {
    "name": "carb-counter-app",
    "slug": "carb-counter-app",
    "experiments": {
      "baseUrl": "/carb-counter-app"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
